<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- سبک طراحی کندو: قلم وزیرمتن، راست‌به‌چپ، دکمه‌ی اصلی همیشه عسلی،
         یک کار اصلی در هر صفحه، هشدار با رنگ و متن (نه فقط رنگ). -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource KandooHoney}" />
        <Setter Property="TextColor" Value="{StaticResource KandooBrown}" />
        <Setter Property="FontFamily" Value="Vazirmatn" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource KandooWax}" />
        <Setter Property="TextColor" Value="{StaticResource KandooBrown}" />
        <Setter Property="FontFamily" Value="Vazirmatn" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BorderColor" Value="{StaticResource KandooHoney}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>
    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="Vazirmatn" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource KandooBrown}" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
    </Style>
    <Style x:Key="PageSubtitle" TargetType="Label">
        <Setter Property="FontFamily" Value="Vazirmatn" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource KandooMuted}" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="Vazirmatn" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource KandooBrown}" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
    </Style>
    <Style TargetType="Entry">
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="FontFamily" Value="Vazirmatn" />
        <Setter Property="TextColor" Value="{StaticResource KandooBrown}" />
        <Setter Property="BackgroundColor" Value="White" />
    </Style>
    <Style TargetType="SearchBar">
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="FontFamily" Value="Vazirmatn" />
        <Setter Property="BackgroundColor" Value="White" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="FontFamily" Value="Vazirmatn" />
        <Setter Property="TextColor" Value="{StaticResource KandooBrown}" />
    </Style>
    <Style TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource KandooWax}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="BorderColor" Value="Transparent" />
    </Style>
    <Style TargetType="Page">
        <Setter Property="BackgroundColor" Value="{StaticResource KandooBackground}" />
    </Style>
</ResourceDictionary>
