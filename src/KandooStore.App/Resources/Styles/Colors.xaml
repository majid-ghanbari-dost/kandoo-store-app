<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- پالت طراحی کندو (docs/design-canvas/Main.dc.html — هویت بصری):
         عسلی #F2A900 دکمه‌ی اصلی، قهوه‌ای تیره #2B1D0E متن/عنوان،
         کرم #FFF8E7 پس‌زمینه، موم #F5E9C8 کارت، سبز #256B43 موفقیت،
         قهوه‌ای بازبینی #9A3B0A هشدار (نه خطا). کلیدهای قدیمی KandooNavy/KandooGold
         برای سازگاری نگه داشته شده‌اند و به رنگ‌های جدید نگاشت شده‌اند. -->
    <Color x:Key="KandooHoney">#F2A900</Color>
    <Color x:Key="KandooBrown">#2B1D0E</Color>
    <Color x:Key="KandooCream">#FFF8E7</Color>
    <Color x:Key="KandooWax">#F5E9C8</Color>
    <Color x:Key="KandooSuccess">#256B43</Color>
    <Color x:Key="KandooReview">#9A3B0A</Color>
    <Color x:Key="KandooMuted">#5A4630</Color>
    <Color x:Key="KandooNavy">#2B1D0E</Color>
    <Color x:Key="KandooGold">#F2A900</Color>
    <Color x:Key="KandooWhite">#FFFFFF</Color>
    <Color x:Key="KandooBackground">#FFF8E7</Color>
    <Color x:Key="Primary">#F2A900</Color>
    <Color x:Key="Secondary">#2B1D0E</Color>
    <Color x:Key="Tertiary">#5A4630</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
