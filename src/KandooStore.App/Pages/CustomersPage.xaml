<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KandooStore.App.Pages.CustomersPage"
             FlowDirection="RightToLeft"
             Title="مشتریان">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Style="{StaticResource PageTitle}" Text="مشتری‌ها" />
        <Label Style="{StaticResource PageSubtitle}" Text="نام | موبایل | جمع خرید | طلب" />
        <CollectionView x:Name="CustomersView" SelectionMode="Single" SelectionChanged="OnCustomerSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame>
                    <VerticalStackLayout Padding="8">
                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                        <Label Text="{Binding Phone}" FontSize="13" TextColor="Gray" />
                    </VerticalStackLayout>
                </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Text="مشتری جدید" Clicked="OnAddCustomerClicked" />
        <Label x:Name="HistoryLabel" FontSize="13" />
    </VerticalStackLayout>
</ContentPage>
