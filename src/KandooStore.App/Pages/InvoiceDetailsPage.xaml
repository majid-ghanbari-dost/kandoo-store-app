<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KandooStore.App.Pages.InvoiceDetailsPage"
             FlowDirection="RightToLeft"
             Title="جزئیات فاکتور">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Style="{StaticResource PageSubtitle}" Text="فاکتور دیجیتال کندو" />
        <Label x:Name="TitleLabel" FontAttributes="Bold" FontSize="18" />
        <Label x:Name="CustomerLabel" FontSize="14" />
        <Label x:Name="TotalLabel" FontSize="20" FontAttributes="Bold" />
        <Label Style="{StaticResource PageSubtitle}" Text="قابل پرداخت" />
        <Label x:Name="StatusLabel" FontSize="14" />
        <Label x:Name="JalaliLabel" FontSize="14" />
        <Label x:Name="PayloadHashLabel" FontSize="12" TextColor="Gray" />
        <Label Style="{StaticResource PageSubtitle}" Text="این فاکتور دیجیتال را نگه دارید. ساخته‌شده با کندو" />
        <CollectionView x:Name="LinesView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label FontSize="14">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding ProductName}" />
                                <Span Text=" × " /><Span Text="{Binding Quantity}" />
                                <Span Text=" = " /><Span Text="{Binding LineTotal}" />
                                <Span Text=" ریال" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
